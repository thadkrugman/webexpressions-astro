---
import Container from '@/components/shared/Container.astro';
import {
  Headset,
  KeyRound,
  LaptopMinimalCheck,
  MessageCircle,
} from '@lucide/astro';

const features = [
  {
    title: 'A Scalable Foundation',
    description:
      "I don't just build for today; I build for your future. I will construct your project on a solid, modern foundation designed to grow and adapt right alongside your business.",
    icon: LaptopMinimalCheck,
  },
  {
    title: 'Full Ownership & No Lock-In',
    description:
      'I build exclusively with standard, best-practice technologies. At the end of our project, you receive full ownership of a clean, portable codebase. There are no proprietary systems, and you will never be held hostage.',
    icon: KeyRound,
  },
  {
    title: 'Dedicated Post-Launch Support',
    description:
      "My commitment doesn't end at launch. I provide dedicated post-launch support to ensure a seamless transition, resolve any issues quickly, and empower you to confidently manage your new digital asset.",
    icon: Headset,
  },
  {
    title: 'Transparent Communication',
    description:
      'No project managers, no mixed messages. You will work directly with me from start to finish. This ensures crystal-clear communication, rapid decision-making, and a development process that is truly built around you.',
    icon: MessageCircle,
  },
];
---

<Container as='section'>
  <div
    class='max-w-4xl animate-fade-in-up scroll-trigger lg:mx-auto lg:text-center'
  >
    <p class='kicker'>The webexpressions Advantage</p>
    <h2 class='heading-1 mt-2'>A Strategic Partnership</h2>
    <p
      class='mt-8 text-lg lg:text-xl/8 text-foreground font-medium lg:mx-auto max-w-[790px] text-pretty'
    >
      When you work with me, you're not just hiring a developer. You're gaining
      a strategic partner who is invested in your success. My approach is built
      on direct collaboration and a commitment to delivering results that matter
      to your business.
    </p>
  </div>
  <div
    class='space-y-8 text-foreground grid w-full lg:grid-cols-2 lg:gap-x-8 mt-16 sm:mt-20'
  >
    {
      features.map((feature, index) => (
        <div
          class={`relative pl-9 animate-fade-in-up scroll-trigger group cursor-default`}
        >
          <div class='inline font-black text-foreground text-base/7 lg:text-lg/7'>
            <feature.icon
              class='absolute left-1 top-1 size-5 text-primary group-hover:text-accent'
              aria-hidden='true'
              stroke-width={2.2}
            />
            {feature.title}
          </div>
          <p class='inline pl-1 text-base/7 lg:text-lg/7 font-medium'>
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
</Container>
