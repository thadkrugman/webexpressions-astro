---
import Container from '@/components/shared/Container.astro';
import {
  Headset,
  KeyRound,
  LaptopMinimalCheck,
  MessageCircle,
} from '@lucide/astro';

const features = [
  {
    title: 'A Scalable Foundation',
    description:
      "I don't just build for today; I build for your future. Your project will be built on a solid, modern foundation that can grow and adapt with your business.",
    icon: LaptopMinimalCheck,
  },
  {
    title: 'Full Ownership & No Lock-In',
    description:
      'You get a site built with standard, best-practice technologies. At the end of our project, you have full ownership of a clean codebase with no proprietary systems holding you hostage.',
    icon: KeyRound,
  },
  {
    title: 'Dedicated Post-Launch Support',
    description:
      "My commitment doesn't end at launch. I provide dedicated support to ensure a smooth transition, fix any issues, and empower you to manage your new digital asset confidently.",
    icon: Headset,
  },
  {
    title: 'Transparent Communication',
    description:
      'No project managers, no mixed messages. You work directly with me throughout the entire process, ensuring clear communication, quick decisions, and a development experience built around your needs.',
    icon: MessageCircle,
  },
];
---

<Container as='section'>
  <div
    class='max-w-4xl animate-fade-in-up scroll-trigger lg:mx-auto lg:text-center'
  >
    <p class='kicker'>The webexpressions Advantage</p>
    <h2 class='heading-1 mt-2'>A Strategic Partnership</h2>
    <p
      class='mt-6 text-lg lg:text-xl/8 text-foreground font-medium lg:mx-auto max-w-3xl'
    >
      When you work with Webexpressions, you're not just hiring a
      developer—you're gaining a strategic partner who is invested in your
      success. My approach is built on direct collaboration and a commitment to
      delivering results that matter to your business.
    </p>
  </div>
  <div
    class='space-y-8 text-foreground grid w-full lg:grid-cols-2 lg:gap-x-8 mt-16 sm:mt-20'
    aria-label='Key advantages and benefits'
  >
    {
      features.map((feature, index) => (
        <div
          class={`relative pl-9 animate-fade-in-up scroll-trigger group cursor-default`}
        >
          <div class='inline font-black text-foreground text-base/7 lg:text-lg/7'>
            <feature.icon
              class='absolute left-1 top-1 size-5 text-primary group-hover:text-accent'
              aria-hidden='true'
              stroke-width={2.2}
            />
            {feature.title}
          </div>
          <p class='inline text-base/7 lg:text-lg/7 font-medium'>
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
</Container>
