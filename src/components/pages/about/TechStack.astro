---
import Container from '@/components/shared/Container.astro';
import TypeScriptLogo from '@/assets/images/about/tech-logos/typescript.svg';
import AstroLogo from '@/assets/images/about/tech-logos/astro.svg';
import ReactLogo from '@/assets/images/about/tech-logos/react.svg';
import SvelteLogo from '@/assets/images/about/tech-logos/svelte.svg';
import SolidLogo from '@/assets/images/about/tech-logos/solid.svg';
import ExpoLogo from '@/assets/images/about/tech-logos/expo.svg';
import TanstackLogo from '@/assets/images/about/tech-logos/tanstack.svg';
import BunLogo from '@/assets/images/about/tech-logos/bun.svg';
import NodeLogo from '@/assets/images/about/tech-logos/nodejs.svg';
import TailwindLogo from '@/assets/images/about/tech-logos/tailwindcss.svg';
import ShadcnLogo from '@/assets/images/about/tech-logos/shadcn-ui.svg';
import SanityLogo from '@/assets/images/about/tech-logos/sanity.svg';
import PlanetscaleLogo from '@/assets/images/about/tech-logos/planetscale.svg';
import DrizzleLogo from '@/assets/images/about/tech-logos/drizzle.svg';
import ClerkLogo from '@/assets/images/about/tech-logos/clerk.svg';
import BetterAuthLogo from '@/assets/images/about/tech-logos/better-auth.svg';
import ShopifyLogo from '@/assets/images/about/tech-logos/shopify.svg';
import VercelLogo from '@/assets/images/about/tech-logos/vercel.svg';

const companies = [
  {
    name: 'TypeScript',
    icon: TypeScriptLogo,
    category: 'Language',
  },
  {
    name: 'Astro',
    icon: AstroLogo,
    category: 'Framework',
  },
  {
    name: 'React',
    icon: ReactLogo,
    category: 'Framework',
  },
  {
    name: 'Svelte',
    icon: SvelteLogo,
    category: 'Framework',
  },
  {
    name: 'Solid',
    icon: SolidLogo,
    category: 'Framework',
  },
  {
    name: 'TanStack',
    icon: TanstackLogo,
    category: 'Framework',
  },
  {
    name: 'Expo',
    icon: ExpoLogo,
    category: 'Framework',
  },
  {
    name: 'Bun',
    icon: BunLogo,
    category: 'Runtime',
  },
  {
    name: 'NodeJS',
    icon: NodeLogo,
    category: 'Runtime',
  },
  {
    name: 'TailwindCSS',
    icon: TailwindLogo,
    category: 'CSS Framework',
  },
  {
    name: 'Shadcn UI',
    icon: ShadcnLogo,
    category: 'UI Framework',
  },
  {
    name: 'Sanity',
    icon: SanityLogo,
    category: 'CMS',
  },
  {
    name: 'PlanetScale',
    icon: PlanetscaleLogo,
    category: 'Database',
  },
  {
    name: 'Drizzle',
    icon: DrizzleLogo,
    category: 'ORM',
  },
  {
    name: 'Clerk',
    icon: ClerkLogo,
    category: 'Auth',
  },
  {
    name: 'BetterAuth',
    icon: BetterAuthLogo,
    category: 'Auth',
  },
  {
    name: 'Shopify',
    icon: ShopifyLogo,
    category: 'E-commerce',
  },
  {
    name: 'Vercel',
    icon: VercelLogo,
    category: 'Hosting',
  },
];
---

<Container>
  <div class='mx-auto max-w-2xl text-center animate-fade-in-up scroll-trigger'>
    <p class='kicker'>Tech Stack</p>
    <h2 class='heading-1 mt-2'>Built for Tomorrow</h2>
    <p class='mt-6 text-lg lg:text-xl/8 text-foreground font-medium'>
      Leveraging cutting-edge technologies to deliver lightning-fast
      performance, bulletproof security, and seamless user experiences that
      scale with your business.
    </p>
  </div>
  <ul
    role='list'
    class='mx-auto mt-16 sm:mt-20 grid max-w-2xl max-[439px]:grid-cols-2 grid-cols-3 gap-x-8 gap-y-16 text-center md:grid-cols-4 lg:mx-0 lg:max-w-none lg:grid-cols-5 xl:grid-cols-6'
  >
    {
      companies.map((company) => (
        <li class='text-primary hover:text-accent animate-fade-in-up scroll-trigger cursor-default'>
          <div class='w-full flex items-center justify-center max-w-20 mx-auto'>
            <company.icon
              class='aspect-square h-full w-full'
              aria-label={`${company.name} logo`}
            />
          </div>
          <h3 class='mt-4 text-xl/8 font-bold'>{company.name}</h3>
        </li>
      ))
    }
  </ul>
</Container>
