---
import Container from '@/components/shared/Container.astro';

const steps = [
  {
    name: 'Discovery & Strategy',
    description:
      'Every great project starts with a deep understanding. I begin by diving into your goals, audience, and project requirements to build a comprehensive strategy for success.',
  },
  {
    name: 'Design & Prototyping',
    description:
      'I translate our strategy into a tangible vision. Through wireframes and high-fidelity mockups, I will craft a user experience that is intuitive, engaging, and perfectly aligned with your brand identity.',
  },
  {
    name: 'Development & Testing',
    description:
      'This is where the vision comes to life. Leveraging a modern, best-in-class tech stack, I will engineer a high-performance, responsive digital solution. Rigorous testing throughout development ensures a flawless final product.',
  },
  {
    name: 'Launch & Support',
    description:
      'A successful launch is just the beginning. After a final review and your approval, I handle the full deployment process. My commitment continues with the dedicated post-launch support needed for a seamless transition and your long-term success.',
  },
];
---

<Container>
  <div class='mx-auto max-w-2xl text-center animate-fade-in-up scroll-trigger'>
    <p class='kicker'>The Blueprint</p>
    <h2 class='heading-1 mt-2'>My Process</h2>
    <p
      class='mt-8 text-lg lg:text-xl/8 text-foreground font-medium max-w-3xl mx-auto'
    >
      My structured process is designed for clarity and collaboration, ensuring
      exceptional results at every stage of your project's journey.
    </p>
  </div>

  <div class='relative mt-16 sm:mt-20'>
    <div
      class='hidden lg:block absolute left-1/2 top-0 -ml-px h-full w-0.5 bg-muted'
      aria-hidden='true'
    >
    </div>
    <div class='grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-20'>
      {
        steps.map((step, index) => (
          <div class='flex items-start gap-x-6 animate-fade-in-up scroll-trigger group cursor-default'>
            <div class='flex-shrink-0'>
              <div class='flex size-10 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold group-hover:bg-accent'>
                {index + 1}
              </div>
            </div>
            <div>
              <h3 class='text-lg lg:text-xl font-extrabold text-foreground tracking-tight'>
                {step.name}
              </h3>
              <p class='mt-2 text-base/7 lg:text-lg/7 text-foreground font-medium'>
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Container>
