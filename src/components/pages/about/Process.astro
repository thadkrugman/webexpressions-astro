---
import Container from '@/components/shared/Container.astro';

const steps = [
  {
    name: 'Discovery & Strategy',
    description:
      'We start by understanding your goals, audience, and project requirements to build a solid strategy for success.',
  },
  {
    name: 'Design & Prototyping',
    description:
      'I create wireframes and high-fidelity mockups to visualize the user experience and ensure the design aligns with your brand.',
  },
  {
    name: 'Development & Testing',
    description:
      'Using modern technologies, I build a high-performance, responsive website and conduct rigorous testing to ensure quality.',
  },
  {
    name: 'Launch & Support',
    description:
      'After a final review, I deploy your project and provide ongoing support to ensure a smooth launch and continued success.',
  },
];
---

<Container>
  <div class='text-center animate-fade-in-up scroll-trigger'>
    <p class='kicker'>The Process</p>
    <h2 class='heading-1 mt-2'>My Process</h2>
    <p
      class='mt-6 text-lg lg:text-xl/8 text-foreground font-medium max-w-3xl mx-auto'
    >
      I follow a structured process to ensure every project is delivered on time
      and to the highest standard.
    </p>
  </div>

  <div class='relative mt-12'>
    <div
      class='absolute left-0 lg:left-1/2 top-0 -ml-px h-full w-0.5 bg-border'
      aria-hidden='true'
    >
    </div>
    <div
      class='grid grid-cols-1 gap-y-12 lg:grid-cols-2 lg:gap-x-12 pl-4 lg:pl-0'
    >
      {
        steps.map((step, index) => (
          <div
            class:list={[
              'flex items-start gap-x-6 animate-fade-in-up scroll-trigger',
              `lg:animate-delay-${(index + 1) * 100}`,
            ]}
          >
            <div class='flex-shrink-0'>
              <div class='flex size-10 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold'>
                {index + 1}
              </div>
            </div>
            <div>
              <h3 class='text-xl font-bold text-foreground'>{step.name}</h3>
              <p class='mt-2 text-base/7 text-foreground-secondary'>
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Container>
