---
import Container from '@/components/shared/Container.astro';
import MessagesSquare from '@lucide/astro/icons/messages-square';
import Rocket from '@lucide/astro/icons/rocket';
import Layers from '@lucide/astro/icons/layers';
import Target from '@lucide/astro/icons/target';
import Code from '@/assets/images/about/philosophy/code.png';
import { Picture } from 'astro:assets';
import { Handshake } from '@lucide/astro';

const features = [
  {
    title: 'Direct 1-on-1 Collaboration',
    description:
      "You'll work directly with me, the expert, from start to finish. This means no project managers or mixed messages. You get clear, efficient communication and a single point of contact dedicated to your project.",
    icon: MessagesSquare,
  },
  {
    title: 'Versatile & Modern Development',
    description:
      'Whether you need a lightning-fast marketing site or a complex web application, I leverage modern technologies and leading frameworks like Astro, React, Svelte, and Expo to deliver secure, SEO-optimized, high-performance solutions tailored to your specific goals.',
    icon: Rocket,
  },
  {
    title: 'Design & Development, Unified',
    description:
      'I handle both the visual design and the technical development, ensuring a seamless process from the first sketch to the final line of code. This unified approach leads to a more cohesive product and a more efficient workflow for your project.',
    icon: Layers,
  },
  {
    title: 'A Focus on Quality & Results',
    description:
      "I'm committed to delivering a final product that your customers will love and that drives real success for your business. This focus on quality and results is why I maintain a 100% client satisfaction rate.",
    icon: Target,
  },
];
---

<Container className='lg:flex-row lg:gap-x-12 gap-y-16 sm:gap-y-20 lg:gap-y-0'>
  <div class='w-full lg:max-w-2xl'>
    <div class='animate-fade-in-up scroll-trigger lg:animate-delay-200'>
      <p class='kicker'>The Advantage</p>
      <h2 class='heading-1'>Your Strategic Development Partner</h2>
    </div>
    <div class='animate-fade-in-up scroll-trigger lg:animate-delay-400 mt-16'>
      <div class='flex items-center gap-2'>
        <Handshake class='size-8 mt-1' />
        <h3 class='heading-3'>A True Partner</h3>
      </div>
      <p
        class='mt-2 ml-10 sm:mt-3 text-lg lg:text-xl/8 text-foreground font-medium max-w-3xl animate-fade-in-up lg:animate-delay-300 scroll-trigger'
      >
        Partnering with me means gaining a strategic ally dedicated to your
        success. My process is built on direct 1-on-1 collaboration, meaning you
        work with me, the expert, from start to finish. This unified approach
        eliminates agency breakdowns and ensures your vision is executed with
        clarity and efficiency
      </p>
    </div>
    <div class='animate-fade-in-up scroll-trigger lg:animate-delay-600 mt-8'>
      <div class='flex items-center gap-2'>
        <Handshake class='size-8 mt-1' />
        <h3 class='heading-3'>A Focus on Results</h3>
      </div>
      <p
        class='mt-2 ml-10 sm:mt-3 text-lg lg:text-xl/8 text-foreground font-medium max-w-3xl animate-fade-in-up lg:animate-delay-500 scroll-trigger'
      >
        This partner-first model allows me to focus entirely on being
        results-driven. Every decision is centered on achieving your business
        goals and delivering a strong return on investment. I use a modern,
        future-proof tech stack, selecting the right tools like Astro, React, or
        Svelte to build secure, high-performance solutions that are scalable and
        built to last.
      </p>
    </div>
  </div>
  <div
    class='flex flex-col items-start lg:order-first w-full animate-fade-in-right scroll-trigger'
  >
    <div class='flex rounded-xl bg-primary overflow-hidden'>
      <Picture
        src={Code}
        alt='Code'
        class='w-full h-auto object-cover'
        sizes='(max-width: 768px) 100vw, 50vw'
      />
    </div>
  </div>
</Container>
