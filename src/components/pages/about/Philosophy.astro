---
import Container from '@/components/shared/Container.astro';
import Code from '@/assets/images/about/philosophy/code.png';
import { Picture } from 'astro:assets';
import { Headset, KeyRound, LaptopMinimalCheck } from '@lucide/astro';

const features = [
  {
    title: 'A Scalable Foundation',
    description:
      "I don't just build for today; I build for your future. Your project will be built on a solid, modern foundation that can grow and adapt with your business.",
    icon: LaptopMinimalCheck,
    animationClass: 'lg:animate-delay-300',
    marginTopClass: 'mt-16 sm:mt-20',
  },
  {
    title: 'Full Ownership & No Lock-In',
    description:
      'You get a site built with standard, best-practice technologies. At the end of our project, you have full ownership of a clean codebase with no proprietary systems holding you hostage.',
    icon: KeyRound,
    animationClass: 'lg:animate-delay-400',
    marginTopClass: 'mt-8',
  },
  {
    title: 'Dedicated Post-Launch Support',
    description:
      "My commitment doesn't end at launch. I provide dedicated support to ensure a smooth transition, fix any issues, and empower you to manage your new digital asset confidently.",
    icon: Headset,
    animationClass: 'lg:animate-delay-400',
    marginTopClass: 'mt-8',
  },
];
---

<Container className='lg:flex-row lg:gap-x-12 gap-y-16 sm:gap-y-20 lg:gap-y-0'>
  <div class='w-full lg:max-w-2xl'>
    <div class='animate-fade-in-up scroll-trigger lg:animate-delay-200'>
      <p class='kicker'>The Advantage</p>
      <h2 class='heading-1 mt-2'>A Strategic Partnership</h2>
      <p
        class='mt-6 text-lg lg:text-xl/8 text-foreground font-medium lg:mx-auto max-w-3xl'
      >
        When you work with Webexpressions, you're not just hiring a
        developer—you're gaining a strategic partner who is invested in your
        success. My approach is built on direct collaboration and a commitment
        to delivering results that matter to your business.
      </p>
    </div>
    {
      features.map((feature) => (
        <div
          class:list={[
            'relative pl-9 animate-fade-in-up scroll-trigger',
            feature.animationClass,
            feature.marginTopClass,
          ]}
        >
          <div class='inline font-black text-foreground text-base/7 lg:text-lg/7'>
            <feature.icon
              class='absolute left-1 top-1 size-5 text-primary'
              aria-hidden='true'
            />
            {feature.title}
          </div>
          <p class='inline text-base/7 lg:text-lg/7 font-medium'>
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
  <div
    class='flex flex-col items-start lg:order-first w-full animate-fade-in-right scroll-trigger'
  >
    <div class='flex rounded-xl bg-primary overflow-hidden'>
      <Picture
        src={Code}
        alt='Code'
        class='w-full h-auto object-cover'
        sizes='(max-width: 768px) 100vw, 50vw'
      />
    </div>
  </div>
</Container>
