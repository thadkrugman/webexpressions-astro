---
import Container from '@/components/shared/Container.astro';
import { Picture } from 'astro:assets';
import Code from '@/assets/images/about/philosophy/code.jpg';
import Kb1 from '@/assets/images/about/philosophy/kb-1.jpg';
import Kb2 from '@/assets/images/about/philosophy/kb-2.jpg';
import Pc from '@/assets/images/about/philosophy/pc.jpg';
import Pc2 from '@/assets/images/about/philosophy/pc-2.jpg';
import Lh from '@/assets/images/about/philosophy/lh.jpg';
import Wf from '@/assets/images/about/philosophy/wf.jpg';
import Hello from '@/assets/images/about/philosophy/hello.jpg';
import Code2 from '@/assets/images/about/philosophy/code-2.jpg';
import Create from '@/assets/images/about/philosophy/create.jpg';
import HulkHand from '@/assets/images/about/philosophy/hulk-hand.jpg';

const stats = [
  {
    label: 'Lighthouse Target',
    value: '100%',
  },
  {
    label: 'Years of Experience',
    value: '5+',
  },
  {
    label: 'Partner Communication',
    value: '1-on-1',
  },
  {
    label: 'Client Asset Ownership',
    value: '100%',
  },
];

const images = [
  {
    src: HulkHand,
    alt: '',
    divClass: '',
    imgClass: 'block size-full object-cover saturate-200',
  },
  {
    src: Hello,
    alt: '',
    divClass: '-mt-8 lg:-mt-40',
    imgClass: 'block size-full object-cover',
  },
  {
    src: Create,
    alt: '',
    divClass: '',
    imgClass: 'block size-full object-cover',
  },
  {
    src: Pc,
    alt: '',
    divClass: '-mt-8 lg:-mt-40',
    imgClass: 'block size-full object-cover',
  },
];
---

<Container as='section' className='relative overflow-hidden'>
  <div class='max-w-4xl animate-fade-in-up scroll-trigger'>
    <p class='kicker'>My Guiding Philosophy</p>
    <h2 class='heading-1 mt-2'>
      A Digital Foundation,<br class='hidden lg:block' />Built for Growth
    </h2>
    <p
      class='mt-6 text-balance text-lg lg:text-xl/8 text-foreground font-medium'
    >
      A great website is more than just beautiful design and clean code—it's
      your most critical business asset. My approach is rooted in the belief
      that a successful digital presence must be a meticulously engineered
      foundation, built not just for today's launch, but for tomorrow's
      opportunities.
    </p>
  </div>
  <div class='mt-20 grid grid-cols-1 lg:grid-cols-2 lg:gap-x-8 lg:gap-y-16'>
    <div class='lg:pr-8'>
      <h3 class='heading-3 animate-fade-in-up scroll-trigger'>My Mission</h3>
      <p
        class='mt-6 text-base/7 lg:text-lg/7 text-foreground font-medium animate-fade-in-up scroll-trigger'
      >
        My mission is to translate your business goals into a high-performance
        digital experience. I see too many businesses held back by slow,
        outdated, or generic websites that fail to connect with users and drive
        results. I solve this by fusing cutting-edge technology with a deep
        understanding of what makes a business succeed online.
      </p>
      <p
        class='mt-8 text-base/7 lg:text-lg/7 text-foreground font-medium animate-fade-in-up scroll-trigger'
      >
        For me, this process is built on a partnership of transparency and
        direct collaboration. I work to empower you—not just by delivering a
        final product, but by creating a clear path to success where you are
        involved, informed, and ultimately in full control of your new digital
        foundation.
      </p>
    </div>
    <div class='pt-16 lg:row-span-2 lg:-mr-16 xl:mr-auto'>
      <div
        class='-mx-8 grid grid-cols-2 gap-4 sm:-mx-16 sm:grid-cols-4 lg:mx-0 lg:grid-cols-2 lg:gap-4 xl:gap-8'
      >
        {
          images.map((image) => (
            <div
              class={`${image.divClass} overflow-hidden rounded-xl aspect-square border border-black/[0.05] shadow-[0_5px_12px_rgba(0,0,0,0.05)] animate-fade-in-up scroll-trigger`}
            >
              <Picture
                alt={image.alt}
                src={image.src}
                class={image.imgClass}
                width={560}
                height={560}
              />
            </div>
          ))
        }
      </div>
    </div>
    <div class='max-lg:mt-16 lg:col-span-1'>
      <p
        class='text-xl/7 font-bold text-foreground animate-fade-in-up scroll-trigger'
      >
        The Numbers
      </p>
      <hr
        class='mt-6 border-t border-gray-100 animate-fade-in-up scroll-trigger'
      />
      <dl class='mt-6 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2'>
        {
          stats.map((stat, index) => (
            <div
              class={`flex flex-col gap-y-2 animate-fade-in-up scroll-trigger ${
                index < 2 ? 'border-b border-gray-100 pb-4' : ''
              } ${
                index === 2 ?
                  'max-sm:border-b max-sm:border-gray-100 max-sm:pb-4'
                : ''
              }`}
            >
              <dt class='text-base/7 text-foreground font-semibold'>
                {stat.label}
              </dt>
              <dd class='order-first text-6xl font-bold tracking-tight'>
                <span>{stat.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</Container>
