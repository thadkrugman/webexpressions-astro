---
import AccentDot from '@/components/shared/AccentDot.astro';
import Container from '@/components/shared/Container.astro';
import {
  Headset,
  KeyRound,
  LaptopMinimalCheck,
  MessageCircle,
} from '@lucide/astro';

const features = [
  {
    title: 'Custom Web Development',
    description:
      "I build high-performance, custom websites from the ground up. Focusing on speed, scalability, and security, I'll create a site that not only looks stunning but is engineered to meet your specific business goals and built to last.",
    classNames: 'lg:border-r border-gray-100 lg:pr-10 xl:mr-3',
    innerClassNames: 'border-b border-gray-100 pb-10',
  },
  {
    title: 'Mobile App Development',
    description:
      'Using modern cross-platform technologies like Expo and React Native, I design and develop beautiful mobile apps for both iOS and Android from a single codebase. The result is a native-feeling experience that reaches your entire audience.',
    classNames: 'lg:pl-10 xl:px-7',
    innerClassNames: 'border-b border-gray-100 pt-10 lg:pt-0 pb-10',
  },
  {
    title: 'Headless Architecture',
    description:
      'I specialize in modern headless architecture, decoupling your frontend from your backend. This provides ultimate flexibility, better performance, and allows us to use the best-in-class tools for every part of your project, from the CMS to the user interface.',
    classNames:
      'lg:max-xl:border-r xl:border-l border-gray-100 lg:max-xl:pr-10 xl:pl-10 xl:ml-3',
    innerClassNames: 'border-b border-gray-100 pb-10 max-xl:pt-10',
  },
  {
    title: 'UI/UX Design',
    description:
      'A great digital product starts with a thoughtful user experience. I create intuitive, user-centric designs and beautiful interfaces that are not only a joy to use but are strategically crafted to guide users and drive conversions.',
    classNames: 'xl:border-r border-gray-100 lg:max-xl:pl-10 xl:pr-10 xl:mr-3',
    innerClassNames: 'max-xl:border-b border-gray-100 pt-10 max-xl:pb-10',
  },
  {
    title: 'Content & SEO Strategy',
    description:
      "I help you plan and structure your site's content for maximum impact, ensuring it's optimized for search engines, speaks directly to your target audience, and builds your brand authority.",
    classNames: 'lg:max-xl:border-r border-gray-100 lg:max-xl:pr-10 xl:px-7',
    innerClassNames: 'pt-10 max-lg:border-b border-gray-100 max-lg:pb-10',
  },
  {
    title: 'Performance & Technical Audits',
    description:
      "Is your existing site slow, buggy, or underperforming in search? I provide in-depth technical audits to identify bottlenecks, improve Core Web Vitals, and create a clear roadmap for enhancing your site's performance and SEO rankings.",
    classNames: 'xl:border-l border-gray-100 lg:pl-10 xl:ml-3',
    innerClassNames: 'pt-10',
  },
];
---

<Container as='section'>
  <div class='mx-auto max-w-2xl lg:mx-0 animate-fade-in-up scroll-trigger'>
    <h2 class='kicker'>What I Offer</h2>
    <p class='mt-2 heading-1'>Engineering Your Competitive Edge</p>
    <p
      class='mt-6
      text-lg
      lg:text-xl/8
      text-foreground
      font-medium'
    >
      From foundational strategy to pixel-perfect execution, I provide the
      end-to-end services required to build exceptional websites and
      applications. Each offering is designed to work together to create a
      cohesive, powerful, and scalable digital product.
    </p>
  </div>
  <div
    class='mt-16 sm:mt-20 grid grid-cols-1 gap-x-0 lg:grid-cols-2 xl:grid-cols-3'
  >
    {
      features.map((feature) => (
        <div
          class={`${feature.classNames} animate-fade-in-up scroll-trigger group cursor-default`}
        >
          <div class={`${feature.innerClassNames} w-full h-full`}>
            <div class='flex items-center gap-x-2'>
              <AccentDot className='size-2.5 lg:size-2.75 mt-0.5' />
              <h3 class='text-lg lg:text-xl font-extrabold text-foreground tracking-tight'>
                {feature.title}
              </h3>
            </div>
            <div class='mt-2 ml-4.5 lg:ml-4.75 text-base/7 lg:text-lg/7 font-medium'>
              {feature.description}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Container>
