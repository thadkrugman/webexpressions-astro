---
import Container from '@/components/shared/Container.astro';
import {
  Headset,
  KeyRound,
  LaptopMinimalCheck,
  MessageCircle,
} from '@lucide/astro';

const features = [
  {
    title: 'A Scalable Foundation',
    description:
      "I don't just build for today; I build for your future. Your project will be built on a solid, modern foundation that can grow and adapt with your business.",
    icon: LaptopMinimalCheck,
  },
  {
    title: 'Full Ownership & No Lock-In',
    description:
      'You get a site built with standard, best-practice technologies. At the end of our project, you have full ownership of a clean codebase with no proprietary systems holding you hostage.',
    icon: KeyRound,
  },
  {
    title: 'Dedicated Post-Launch Support',
    description:
      "My commitment doesn't end at launch. I provide dedicated support to ensure a smooth transition, fix any issues, and empower you to manage your new digital asset confidently.",
    icon: Headset,
  },
  {
    title: 'Transparent Communication',
    description:
      'No project managers, no mixed messages. You work directly with me throughout the entire process, ensuring clear communication, quick decisions, and a development experience built around your needs.',
    icon: MessageCircle,
  },
  {
    title: 'Dedicated Post-Launch Support',
    description:
      "My commitment doesn't end at launch. I provide dedicated support to ensure a smooth transition, fix any issues, and empower you to manage your new digital asset confidently.",
    icon: Headset,
  },
  {
    title: 'Transparent Communication',
    description:
      'No project managers, no mixed messages. You work directly with me throughout the entire process, ensuring clear communication, quick decisions, and a development experience built around your needs.',
    icon: MessageCircle,
  },
];
---

<Container as='section'>
  <div class='mx-auto max-w-2xl lg:mx-0'>
    <h2 class='kicker'>The Services</h2>
    <p class='mt-2 heading-1'>No server? No problem.</p>
    <p
      class='mt-6
      text-lg
      lg:text-xl/8
      text-foreground
      font-medium'
    >
      Lorem ipsum, dolor sit amet consectetur adipisicing elit. Maiores impedit
      perferendis suscipit eaque, iste dolor cupiditate blanditiis.
    </p>
  </div>
  <dl
    class='mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-8 text-base/7 text-foreground sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3 lg:gap-x-16'
  >
    {
      features.map((feature, index) => (
        <div
          class={`relative pl-9 animate-fade-in-up lg:animate-delay-${Math.min((index + 1) * 100, 600)} scroll-trigger`}
        >
          <dt class='inline font-black text-foreground text-base/7 lg:text-lg/7'>
            <feature.icon
              class='absolute left-1 top-1 size-5 text-primary'
              aria-hidden='true'
            />
            {feature.title}
          </dt>
          <dd class='inline text-base/7 lg:text-lg/7 font-medium'>
            {feature.description}
          </dd>
        </div>
      ))
    }
  </dl>
</Container>
