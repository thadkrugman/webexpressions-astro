---
import Container from '@/components/shared/Container.astro';
import { Image } from 'astro:assets';
import ThadProfile from '@/assets/thad-profile.jpg';
import { Picture } from 'astro:assets';
---

<Container
  as='section'
  className='lg:flex-row text-center animate-fade-in-up scroll-trigger items-center gap-y-8 lg:gap-x-16 lg:justify-between'
>
  <div
    class='text-left max-w-xl animate-fade-in-up scroll-trigger lg:animate-delay-200'
  >
    <p class='kicker'>The Man Behind The Brand</p>
    <h2 class='heading-1 mt-2'>Meet Thad</h2>
    <p class='mt-4 text-lg lg:text-xl/8 text-foreground font-medium'>
      I'm a passionate developer with a love for creating beautiful, functional,
      and user-friendly websites. With a keen eye for design and a commitment to
      clean code and performance, I help businesses establish a strong online
      presence and achieve their goals.
    </p>
  </div>
  <div
    class='relative rounded-xl animate-fade-in-up scroll-trigger aspect-[4/5] w-full overflow-hidden border border-black/[.04] shadow-[0_6px_16px_rgba(0,0,0,0.05)]'
  >
    <!-- Purple blob -->
    <div
      class='absolute w-48 h-72 bg-gradient-to-br from-violet-600 to-violet-600/80 top-0 left-16 opacity-20'
      style='clip-path: polygon(50% 0%, 100% 0, 44% 35%, 71% 63%, 68% 100%, 32% 100%, 6% 78%, 0% 43%, 0 0);'
    >
    </div>
    <!-- Green blob -->
    <div
      class='absolute w-32 h-40 bg-gradient-to-br from-lime-400 to-lime-400 top-0 right-16 opacity-20'
      style='clip-path: polygon(50% 0%, 100% 0, 100% 59%, 82% 70%, 100% 100%, 38% 100%, 26% 56%, 0 47%, 0 0);'
    >
    </div>
    <div
      class='relative flex flex-col items-center h-full p-3 z-10 backdrop-blur-3xl'
      style='background: linear-gradient(to bottom, transparent 0%, white 60%, white 100%);'
    >
      <Picture
        src={ThadProfile}
        class='size-32 bg-white rounded-xl border border-black/[.04] shadow-[0_6px_8px_rgba(0,0,0,0.03)] mt-16 object-cover object-top'
        alt='Thad Krugman'
        width={128}
        height={128}
        sizes='(max-width: 768px) 100vw, 128px'
        loading='lazy'
        fetchpriority='high'
      />
      <div class='flex flex-col space-y-1 mt-8 text-center'>
        <div>
          <p class='font-bold text-2xl text-foreground'>Thad Krugman</p>
          <p class='text-sm font-medium text-foreground/'>
            UI/UX Designer & Developer
          </p>
        </div>
      </div>
      <div class='mt-8 px-4 text-left'>
        <p class='text-lg font-bold text-foreground'>About</p>
        <p class='text-base/8 font-medium text-foreground mt-2'>
          I'm a passionate developer with a love for creating beautiful,
          functional, and user-friendly websites. With a keen eye for design and
          a commitment to clean code and performance, I help businesses
          establish a strong online presence and achieve their goals.
        </p>
        <p class='text-lg font-bold text-foreground mt-8'>Skills</p>
        <div class='flex flex-wrap gap-2 mt-3'>
          <div
            class='rounded-full bg-primary px-2.5 py-1 text-xs/5 font-semibold text-primary-foreground w-fit'
          >
            Web Design
          </div>
          <div
            class='rounded-full bg-primary px-2.5 py-1 text-xs/5 font-semibold text-primary-foreground w-fit'
          >
            Web Development
          </div>
        </div>
      </div>
    </div>
  </div>
</Container>
