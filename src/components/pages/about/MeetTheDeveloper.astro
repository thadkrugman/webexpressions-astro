---
import Container from '@/components/shared/Container.astro';
import { Image } from 'astro:assets';
// NOTE: This component requires a profile picture.
// Please add an image named `thad-profile.jpg` to the `src/assets/` directory.
import profilePic from '@/assets/thad-profile.jpg';
---

<section class="py-16 sm:py-24 bg-background">
  <Container>
    <div class="max-w-3xl mx-auto text-center animate-fade-in-up scroll-trigger">
      <div class="flex flex-col items-center gap-y-8">
        <div
          class="relative size-32 sm:size-40 rounded-full overflow-hidden border-4 sm:border-6 border-white shadow-lg"
        >
          <Image
            src={profilePic}
            alt="Thad, the developer behind webexpressions"
            class="object-cover size-full"
            widths={[200, 400]}
            sizes="(max-width: 640px) 200px, 400px"
          />
        </div>
        <div>
          <p class="kicker">The Man Behind The Code</p>
          <h2 class="heading-1">Meet Thad</h2>
          <p class="mt-4 text-lg lg:text-xl/8 text-foreground font-medium">
            I'm a passionate developer with a love for creating beautiful, functional, and user-friendly websites. With a keen eye for design and a commitment to clean code, I help businesses establish a strong online presence and achieve their goals.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>