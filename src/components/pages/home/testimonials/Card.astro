---
import { cn } from '@/lib/utils';

type Testimonial = {
  body: string;
  author: {
    name: string;
  };
};

interface Props {
  className?: string;
  testimonial: Testimonial;
  index: number;
  last: boolean;
}

const { className, testimonial, index, last }: Props = Astro.props;
---

<div
  class={cn(
    'w-full group cursor-default animate-fade-in-up scroll-trigger',
    className,
  )}
>
  <figure
    class={`text-sm/6 border-t border-muted ${index === 0 ? 'border-t-0 pt-0 pb-12' : 'py-12'} ${last ? 'pb-0 sm:pb-0' : ''}`}
  >
    <blockquote class='text-foreground font-medium text-base/7'>
      <p>
        <span class='text-accent font-black text-2xl/6'>"</span>
        {testimonial.body}
        <span class='text-accent font-black text-2xl/4'>"</span>
      </p>
    </blockquote>
    <figcaption class='mt-6 flex items-center gap-x-4'>
      <div
        class='size-9 rounded-full bg-primary flex items-center justify-center uppercase text-primary-foreground text-xs font-bold tracking-widest group-hover:bg-accent'
      >
        {
          (() => {
            const nameParts = testimonial.author.name.trim().split(' ');
            if (nameParts.length > 1) {
              return `${nameParts[0].slice(0, 1)}${nameParts[nameParts.length - 1].slice(0, 1)}`;
            } else {
              return testimonial.author.name.slice(0, 2);
            }
          })()
        }
      </div>
      <div class='font-bold text-foreground text-base'>
        {testimonial.author.name}
      </div>
    </figcaption>
  </figure>
</div>
