---
import Container from '@/components/shared/Container.astro';
import MessagesSquare from '@lucide/astro/icons/messages-square';
import Rocket from '@lucide/astro/icons/rocket';
import Layers from '@lucide/astro/icons/layers';
import Target from '@lucide/astro/icons/target';

const features = [
  {
    title: 'Direct 1-on-1 Collaboration',
    description:
      "You'll work directly with me, the expert, from start to finish. This means no project managers or mixed messages. You get clear, efficient communication and a single point of contact dedicated to your project.",
    icon: MessagesSquare,
  },
  {
    title: 'Versatile & Modern Development',
    description:
      'Whether you need a lightning-fast marketing site or a complex web application, I leverage modern technologies and leading frameworks like Astro, React, Svelte, and Expo to deliver secure, SEO-optimized, high-performance solutions tailored to your specific goals.',
    icon: Rocket,
  },
  {
    title: 'Design & Development, Unified',
    description:
      'I handle both the visual design and the technical development, ensuring a seamless process from the first sketch to the final line of code. This unified approach leads to a more cohesive product and a more efficient workflow for your project.',
    icon: Layers,
  },
  {
    title: 'A Focus on Quality & Results',
    description:
      "I'm committed to delivering a final product that your customers will love and that drives real success for your business. This focus on quality and results is why I maintain a 100% client satisfaction rate.",
    icon: Target,
  },
];
---

<Container as='section'>
  <div
    class='max-w-4xl animate-fade-in-up scroll-trigger lg:mx-auto lg:text-center'
  >
    <p class='kicker'>Why Choose webexpressions</p>
    <h2 class='heading-1 mt-2'>Work Directly With An Expert, Not An Agency</h2>
    <p
      class='mt-8 text-lg lg:text-xl/8 text-foreground font-medium lg:mx-auto max-w-3xl'
    >
      Hi, I'm Thad, the founder and developer behind webexpressions. I partner
      directly with you to understand your goals and translate them into modern,
      high-performance digital experiences that deliver real results for your
      business.
    </p>
  </div>
  <div
    class='space-y-8 text-foreground grid w-full lg:grid-cols-2 lg:gap-x-8 mt-16 sm:mt-20'
  >
    {
      features.map((feature) => (
        <div
          class={`relative pl-9 animate-fade-in-up scroll-trigger group cursor-default`}
        >
          <div class='inline font-black text-foreground text-base/7 lg:text-lg/7'>
            <feature.icon
              class='absolute left-1 top-1 size-5 text-primary group-hover:text-accent'
              stroke-width={2.2}
              aria-hidden='true'
            />
            {feature.title}
          </div>
          <p class='inline text-base/7 lg:text-lg/7 font-medium'>
            {feature.description}
          </p>
        </div>
      ))
    }
  </div>
</Container>
