---
import Container from '@/components/shared/Container.astro';
import Button from '@/components/ui/Button.astro';
import PartyPopper from '@lucide/astro/icons/party-popper';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import ProjectShowcase from '@/components/pages/home/hero/ProjectShowcase.astro';
import Rocket from '@lucide/astro/icons/rocket';
import AccentDot from '@/components/shared/AccentDot.astro';
import Badge from '@/components/ui/Badge.astro';

const services = [
  'Intuitive Web Design',
  'Modern Web Development',
  'Engaging Mobile Apps',
];
---

<Container
  as='header'
  isFirstSection={true}
  className='items-center justify-center'
>
  <div
    class='mx-auto
    max-w-3xl
    flex
    flex-col
    items-center
    text-center
    animate-fade-in-up
    scroll-trigger'
  >
    <div class='flex flex-row rounded-full border items-center p-1 max-w-full'>
      <Badge>
        <span>New</span>
        <PartyPopper class='size-3.5 text-background' />
      </Badge>
      <div class='px-3 items-center flex min-w-0 flex-1'>
        <p class='text-sm font-semibold line-clamp-1 max-[440px]:text-xs'>
          Accepting New Clients for {new Date().getFullYear()}
        </p>
      </div>
    </div>
    <h1
      class='max-xs:text-4xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-foreground text-pretty max-xs:leading-12 leading-15 sm:leading-18 md:leading-21 lg:leading-28 mt-5'
    >
      Crafting Digital<br />
      Experiences That<br />
      <span
        class='inline-flex align-middle bg-accent rounded-md md:rounded-lg lg:rounded-xl mx-1 max-xs:p-1.5 p-2 sm:p-2.5 md:p-3.5 lg:p-4.5 max-xs:mb-1.5 mb-2 sm:mb-2.5 md:mb-3 lg:mb-4 mouse-click-icon-wrapper group shadow-[0_12px_35px_rgba(0,0,0,0.12)]'
        aria-hidden='true'
      >
        <MousePointerClick
          class='max-xs:size-5.5 size-7 sm:size-8 md:size-9 lg:size-12 text-foreground mouse-click-icon group-hover:scale-110 transition-transform duration-300'
          aria-hidden='true'
        />
      </span>
      Convert
    </h1>
    <div
      class='flex flex-col lg:flex-row gap-4 lg:gap-8 max-xs:mt-6.5 mt-6 sm:mt-5.5 md:mt-5 lg:mt-4 w-full max-w-3xl mx-auto lg:justify-between items-center'
      role='list'
      aria-label='Services offered'
    >
      {
        services.map((service) => (
          <div
            class='flex flex-row gap-2 items-center justify-center lg:justify-start'
            role='listitem'
          >
            <AccentDot className='max-xs:size-2.5 size-2.75 mt-0.5' />
            <span class='max-xs:text-base text-lg font-semibold'>
              {service}
            </span>
          </div>
        ))
      }
    </div>
    <div class='mt-12'>
      <Button
        size='xl'
        href='/contact'
        className='flex items-center justify-center group'
      >
        Launch Your Project
        <Rocket
          class='size-4 ml-2 group-hover:-translate-y-10 group-hover:translate-x-10 transition-transform duration-500'
          stroke-width={3}
        />
      </Button>
    </div>
  </div>
  <ProjectShowcase />

  <style>
    @keyframes pulseClick {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.2);
      }
      100% {
        transform: scale(1);
      }
    }

    .mouse-click-icon-wrapper .mouse-click-icon {
      display: inline-block;
      animation: pulseClick 0.5s ease-in-out 1s 1 forwards;
    }

    /* Longer delay for larger screens where images fade in separately */
    @media (min-width: 1024px) {
      .mouse-click-icon-wrapper .mouse-click-icon {
        animation: pulseClick 0.5s ease-in-out 1.2s 1 forwards;
      }
    }
  </style>
</Container>
