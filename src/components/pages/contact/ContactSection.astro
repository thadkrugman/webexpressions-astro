---
import Container from '@/components/shared/Container.astro';
import { MapPin, Phone, Mail } from '@lucide/astro';
import Label from '@/components/ui/Label.astro';
import Input from '@/components/ui/Input.astro';
import Textarea from '@/components/ui/Textarea.astro';
import RadioGroup from '@/components/ui/RadioGroup.astro';
import Button from '@/components/ui/Button.astro';

const budgetOptions = [
  { value: '3000-6000', label: '$3,000 - $6,000' },
  { value: '6000-10000', label: '$6,000 - $10,000' },
  { value: '10000+', label: '$10,000+' },
];
---

<Container as='section' className='items-center justify-center flex-1'>
  <div
    class='flex flex-col lg:flex-row gap-y-16 sm:max-lg:gap-y-20 lg:gap-x-20 lg:justify-between w-full'
  >
    <div class='w-full lg:max-w-lg'>
      <p class='kicker'>Get in Touch</p>
      <h2 class='mt-2 heading-1'>Get in touch</h2>
      <p
        class='mt-6 text-lg lg:text-xl/8 font-medium text-foreground text-pretty'
      >
        Proin volutpat consequat porttitor cras nullam gravida at. Orci molestie
        a eu arcu. Sed ut tincidunt integer elementum id sem. Arcu sed malesuada
        et magna.
      </p>
      <dl class='mt-16 space-y-6 text-base/7 text-foreground font-semibold'>
        <div class='flex gap-x-4 items-center'>
          <dt class='flex-none'>
            <span class='sr-only'>Telephone</span>
            <Phone class='size-5.5 text-foreground' stroke-width={2.3} />
          </dt>
          <dd>
            <a
              class='text-foreground hover:text-accent-secondary'
              href='tel:+14402225817'>+1 (440) 222-5817</a
            >
          </dd>
        </div>
        <div class='flex gap-x-4 items-center'>
          <dt class='flex-none'>
            <span class='sr-only'>Address</span>
            <MapPin class='size-6 text-foreground' stroke-width={2.3} />
          </dt>
          <dd>Lorain, OH</dd>
        </div>
      </dl>
    </div>
    <form action='#' method='POST' class='w-full lg:max-w-lg'>
      <div class='space-y-6'>
        <!-- Full Name -->
        <div>
          <Label for='full-name' required>Full Name</Label>
          <div class='mt-2.5'>
            <Input
              type='text'
              name='full-name'
              id='full-name'
              autocomplete='name'
              required
            />
          </div>
        </div>

        <!-- Email Address -->
        <div>
          <Label for='email' required>Email Address</Label>
          <div class='mt-2.5'>
            <Input
              type='email'
              name='email'
              id='email'
              autocomplete='email'
              required
            />
          </div>
        </div>

        <!-- Phone Number -->
        <div>
          <Label for='phone'>Phone Number</Label>
          <div class='mt-2.5'>
            <Input type='tel' name='phone' id='phone' autocomplete='tel' />
          </div>
        </div>

        <!-- Company Name -->
        <div>
          <Label for='company'>Company Name</Label>
          <div class='mt-2.5'>
            <Input
              type='text'
              name='company'
              id='company'
              autocomplete='organization'
            />
          </div>
        </div>

        <!-- Current Website -->
        <div>
          <Label for='website'>Current Website</Label>
          <div class='mt-2.5'>
            <Input
              type='url'
              name='website'
              id='website'
              placeholder='https://...'
              autocomplete='url'
            />
          </div>
        </div>

        <!-- Project Budget -->
        <div>
          <Label required>Project Budget (Estimated)</Label>
          <div class='mt-2.5'>
            <RadioGroup name='budget' options={budgetOptions} required />
          </div>
        </div>

        <!-- Message -->
        <div>
          <Label for='message' required>How can I help you?</Label>
          <div class='mt-2.5'>
            <Textarea name='message' id='message' rows={4} required />
          </div>
        </div>
      </div>

      <div class='mt-8 flex justify-end'>
        <Button type='submit' variant='primary' size='default'>
          Send message
        </Button>
      </div>
    </form>
  </div>
</Container>
