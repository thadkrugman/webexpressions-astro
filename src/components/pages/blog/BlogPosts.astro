---
import Container from '@/components/shared/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { Picture } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---

<Container as='section' id='blog-posts' includeBottomPadding={true}>
  <div class='grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3'>
    {
      sortedPosts.length === 0 && (
        <div class='col-span-full text-center py-12'>
          <p class='text-lg text-foreground'>
            No blog posts found. Check the console for debugging info.
          </p>
        </div>
      )
    }
    {
      sortedPosts.map((post) => (
        <article class='flex max-w-xl flex-col items-start justify-between animate-fade-in-up scroll-trigger'>
          <div class='flex items-center gap-x-4 text-xs'>
            <time
              datetime={new Date(post.data.pubDate).toISOString().split('T')[0]}
              class='text-foreground font-medium'
            >
              {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <Badge>{post.data.category}</Badge>
          </div>
          <div class='group relative'>
            <h3 class='mt-3 text-lg/6 font-extrabold text-foreground group-hover:text-accent'>
              <a href={`/blog/${post.data.slug}`}>
                <span class='absolute inset-0' />
                {post.data.title}
              </a>
            </h3>
            <p class='mt-5 line-clamp-3 text-sm/6 text-foreground font-medium'>
              {post.data.description}
            </p>
          </div>
          <div class='relative mt-8 flex items-center gap-x-4'>
            <Picture
              src='/src/assets/images/blog/thad.jpg'
              alt='Thad Krugman'
              widths={[40, 80, 120]}
              sizes='40px'
              class='size-10 rounded-full'
              width={40}
              height={40}
            />
            <div class='text-sm/6 flex flex-col'>
              <p class='font-extrabold text-foreground'>Thad Krugman</p>
              <p class='text-foreground font-medium'>
                Founder | Designer | Lead Developer
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Container>
