---
import Container from '@/components/shared/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import { Picture } from 'astro:assets';
---

<Container as='section' id='blog-posts' includeBottomPadding={true}>
  <div class='grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3'>
    <article class='flex max-w-xl flex-col items-start justify-between'>
      <div class='flex items-center gap-x-4 text-xs'>
        <time datetime='2020-03-16' class='text-foreground font-medium'
          >Mar 16, 2020</time
        >
        <Badge>Marketing</Badge>
      </div>
      <div class='group relative'>
        <h3
          class='mt-3 text-lg/6 font-extrabold text-foreground group-hover:text-accent'
        >
          <a href='#'>
            <span class='absolute inset-0'></span>
            Coming Soon
          </a>
        </h3>
        <p class='mt-5 line-clamp-3 text-sm/6 text-foreground font-medium'>
          Illo sint voluptas. Error voluptates culpa eligendi. Hic vel totam
          vitae illo. Non aliquid explicabo necessitatibus unde. Sed
          exercitationem placeat consectetur nulla deserunt vel. Iusto corrupti
          dicta.
        </p>
      </div>
      <div class='relative mt-8 flex items-center gap-x-4'>
        <Picture
          src='/src/assets/images/blog/thad.jpg'
          alt='Thad Krugman'
          widths={[40, 80, 120]}
          sizes='40px'
          class='size-10 rounded-full'
          width={40}
          height={40}
        />
        <div class='text-sm/6 flex flex-col'>
          <p class='font-bold text-foreground'>Thad Krugman</p>
          <p class='text-foreground font-medium'>Web Developer & Designer</p>
        </div>
      </div>
    </article>
  </div>

  <!-- More posts... -->
</Container>
