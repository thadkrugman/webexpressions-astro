---
import { cn } from '@/lib/utils';

interface Props {
  className?: string;
  for?: string;
  required?: boolean;
}

const {
  className = '',
  for: htmlFor,
  required = false,
  ...rest
}: Props = Astro.props;

const baseStyles = 'block text-base/7 font-bold text-foreground';
---

<label class={cn(baseStyles, className)} for={htmlFor} {...rest}>
  <slot />
  {required && <span class='text-accent ml-1'>*</span>}
</label>
