---
import { cn } from '@/lib/utils';

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}

interface Props {
  className?: string;
  name: string;
  options: Option[];
  required?: boolean;
  disabled?: boolean;
  defaultValue?: string;
}

const {
  className = '',
  name,
  options,
  required = false,
  disabled = false,
  defaultValue,
  ...rest
}: Props = Astro.props;

const baseStyles = 'space-y-3';
const radioStyles = 'sr-only';
const labelStyles = 'relative flex cursor-pointer items-center gap-3 rounded-md bg-white p-4 text-foreground outline -outline-offset-1 outline-border hover:bg-gray-50 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-accent disabled:cursor-not-allowed disabled:opacity-50';
const indicatorStyles = 'flex size-4 items-center justify-center rounded-full outline -outline-offset-1 outline-border bg-white';
const checkedIndicatorStyles = 'peer-checked:outline-accent peer-checked:bg-accent';
const dotStyles = 'size-2 rounded-full bg-white opacity-0 peer-checked:opacity-100';
---

<div class={cn(baseStyles, className)} {...rest}>
  {options.map((option, index) => (
    <label class={cn(labelStyles, option.disabled && 'cursor-not-allowed opacity-50')}>
      <input
        type="radio"
        name={name}
        value={option.value}
        class={radioStyles}
        required={required && index === 0}
        disabled={disabled || option.disabled}
        checked={defaultValue === option.value}
      />
      <div class={cn(indicatorStyles, checkedIndicatorStyles)}>
        <div class={dotStyles}></div>
      </div>
      <span class="text-sm font-medium">{option.label}</span>
    </label>
  ))}
</div>