---
import { cn } from '@/lib/utils';

interface Props {
  className?: string;
  variant?:
    | 'default'
    | 'accent'
    | 'accent-secondary'
    | 'secondary'
    | 'muted'
    | 'border'
    | 'default-outline'
    | 'accent-outline'
    | 'accent-secondary-outline'
    | 'secondary-outline'
    | 'muted-outline'
    | 'border-outline';
}

const { className, variant = 'default' } = Astro.props;

const variants = {
  // Base variants
  default: 'bg-primary text-primary-foreground',
  accent: 'bg-accent text-accent-foreground',
  'accent-secondary': 'bg-accent-secondary text-accent-secondary-foreground',
  secondary: 'bg-secondary text-secondary-foreground',
  muted: 'bg-muted text-foreground',
  border: 'bg-border text-foreground',

  // Outline variants
  'default-outline': 'bg-transparent border border-primary text-primary',
  'accent-outline': 'bg-transparent border border-accent text-accent',
  'accent-secondary-outline':
    'bg-transparent border border-accent-secondary text-accent-secondary',
  'secondary-outline': 'bg-transparent border border-secondary text-secondary',
  'muted-outline': 'bg-transparent border border-muted text-foreground',
  'border-outline': 'bg-transparent border text-foreground',
};
---

<div
  class={cn(
    'rounded-full px-3 py-1.5 text-xs font-bold tracking-wide flex flex-row space-x-2 w-fit items-center justify-center hover:bg-accent hover:text-secondary hover:border-accent cursor-default select-none',
    variants[variant],
    className,
  )}
>
  <slot />
</div>
