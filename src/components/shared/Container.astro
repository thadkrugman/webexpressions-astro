---
import { cn } from '@/lib/utils';

type HTMLTag =
  | 'div'
  | 'header'
  | 'main'
  | 'section'
  | 'article'
  | 'aside'
  | 'footer'
  | 'nav';

interface Props {
  className?: string;
  as?: HTMLTag;
  id?: string;
  isFirstSection?: boolean;
  includeBottomPadding?: boolean;
}

const {
  className = '',
  as = 'div',
  id,
  isFirstSection = false,
  includeBottomPadding = false,
  ...rest
} = Astro.props;
const Element = as;
---

<Element
  class={cn(
    'flex flex-col px-6 sm:px-8 lg:px-10 xl:px-12 max-w-2xl lg:max-w-7xl mx-auto w-full',
    isFirstSection ? 'pt-16 sm:pt-32 lg:pt-36' : 'pt-24 sm:pt-32 lg:pt-36',
    includeBottomPadding ? 'pb-4 sm:pb-12 lg:pb-16' : '',
    className,
  )}
  id={id}
  {...rest}
>
  <slot />
</Element>
