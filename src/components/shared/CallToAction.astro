---
import Container from '@/components/shared/Container.astro';
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/utils';
import { Layers2 } from '@lucide/astro';

interface Props {
  wrapperClassName?: string;
  containerClassName?: string;
  kicker: string;
  kickerClassName?: string;
  heading: string;
  headingClassName?: string;
  includeBreak?: boolean;
  heading2?: string;
  heading2ClassName?: string;
  button: string;
  buttonHref: string;
  buttonClassName?: string;
  buttonAriaLabel?: string;
  button2: string;
  button2Href: string;
  button2ClassName?: string;
  button2AriaLabel?: string;
}

const {
  wrapperClassName,
  containerClassName,
  kicker,
  kickerClassName,
  heading,
  headingClassName,
  includeBreak,
  heading2,
  button,
  buttonHref,
  buttonClassName,
  buttonAriaLabel,
  button2,
  button2Href,
  button2ClassName,
  button2AriaLabel,
} = Astro.props;
---

<div class={cn('bg-primary mt-24 sm:mt-32 lg:mt-36', wrapperClassName)}>
  <Container
    as='section'
    showBottomBorder={false}
    showSideBorders={false}
    className={cn(
      'lg:flex-row lg:items-center lg:justify-between py-24 sm:py-32 lg:py-36',
      containerClassName,
    )}
  >
    <div class='flex-shrink-0 animate-fade-in-up scroll-trigger'>
      <Layers2
        stroke-width={2.1}
        class='size-12 sm:size-14 mb-5 text-primary-foreground lg:hidden hover:text-accent'
      />

      <p class={cn('kicker text-accent', kickerClassName)}>
        {kicker}
      </p>
      <h2
        class={cn(
          'heading-2 text-primary-foreground mt-2 lg:text-6xl max-w-[645px]',
          headingClassName,
        )}
      >
        {heading}
        {includeBreak && <br class='max-[439px]:hidden' />}
        {heading2 && heading2}
      </h2>
      <div
        class='mt-10 flex max-[440px]:flex-col max-[440px]:gap-y-4 min-[440px]:items-center min-[440px]:gap-x-6 lg:mt-12 lg:shrink-0'
      >
        <Button
          size='xl'
          variant='secondary'
          href={buttonHref}
          className={cn(buttonClassName)}
          aria-label={buttonAriaLabel}
        >
          {button}
        </Button>
        <Button
          size='xl'
          variant='outline-secondary'
          href={button2Href}
          className={cn(button2ClassName)}
          aria-label={button2AriaLabel}
        >
          {button2}
        </Button>
      </div>
    </div>
    <div
      class='hidden lg:flex flex-col flex-1 h-64 items-end justify-center animate-fade-in-up scroll-trigger cursor-default'
    >
      <div
        class='w-fit h-64 text-primary-foreground flex flex-col items-center justify-center hover:text-accent'
      >
        <Layers2 stroke-width={2.1} class={cn('h-full w-auto aspect-square')} />
        <p class='text-4xl font-black mt-6'>webexpressions</p>
      </div>
    </div>
  </Container>
</div>
