---
import { cn } from '@/lib/utils';

interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<div
  class={cn(
    'rounded-full bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground flex flex-row space-x-2 w-fit items-center justify-center',
    className,
  )}
>
  <slot />
</div>
