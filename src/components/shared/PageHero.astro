---
import Container from '@/components/shared/Container.astro';
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/utils';

interface Props {
  kicker: string;
  kickerClassName?: string;
  heading: string;
  headingClassName?: string;
  description: string;
  descriptionClassName?: string;
  button: string;
  buttonHref: string;
  buttonIcon?: any;
  buttonIconClassName?: string;
  buttonIconStrokeWidth?: number;
  buttonClassName?: string;
}

const {
  kicker,
  kickerClassName,
  heading,
  headingClassName,
  description,
  descriptionClassName,
  button,
  buttonHref,
  buttonIcon,
  buttonIconClassName,
  buttonIconStrokeWidth = 3,
  buttonClassName,
} = Astro.props;
---

<Container
  as='header'
  isFirstSection={true}
  className='animate-fade-in-up scroll-trigger items-center justify-center'
>
  <p
    class={cn(
      'text-lg/7 lg:text-[21px]/7 font-bold text-accent-secondary text-center animate-fade-in-up scroll-trigger',
      kickerClassName,
    )}
  >
    {kicker}
  </p>
  <h2
    class={cn(
      '[@media(max-width:439px)]:text-4xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight text-foreground text-pretty [@media(max-width:439px)]:leading-12 leading-15 sm:leading-18 md:leading-21 lg:leading-28 mt-5 text-center',
      headingClassName,
    )}
  >
    {heading}
  </h2>
  <p
    class={cn(
      'mt-8 text-lg lg:text-xl/8 text-foreground font-medium max-w-2xl text-center animate-fade-in-up animate-delay-200 scroll-trigger',
      descriptionClassName,
    )}
  >
    {description}
  </p>
  <div
    class='flex flex-row mt-12 justify-center items-center animate-fade-in-up animate-delay-300 scroll-trigger'
  >
    <Button size='xl' href={buttonHref} className={cn(buttonClassName)}>
      {button}{
        buttonIcon && (
          <buttonIcon
            class={cn(
              'size-4 ml-2 group-hover:-translate-x-2 transition-transform duration-300',
              buttonIconClassName,
            )}
            stroke-width={buttonIconStrokeWidth}
          />
        )
      }
    </Button>
  </div>
</Container>
