---
import Container from '@/components/shared/Container.astro';
import SquareMousePointer from '@lucide/astro/icons/square-mouse-pointer';

const footerSections = [
  {
    title: 'Explore',
    links: [
      { name: 'Home', href: '/' },
      { name: 'About', href: '/about' },
      { name: 'Portfolio', href: '/portfolio' },
      { name: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Services',
    links: [
      { name: 'Web Design', href: '/contact' },
      { name: 'Web Development', href: '/contact' },
      { name: 'App Development', href: '/contact' },
      { name: 'Consultation', href: '/contact' },
    ],
  },
  {
    title: 'Get Started',
    links: [
      { name: 'Contact Us', href: '/contact' },
      { name: 'View My Work', href: '/portfolio' },
    ],
  },
  {
    title: 'Stay Updated',
    links: [
      { name: 'Latest Posts', href: '/blog' },
      { name: 'Follow Progress', href: '/blog' },
    ],
  },
];

const socialLinks = [
  {
    name: 'X',
    href: 'https://x.com/thadkrugman',
    icon: 'M13.6823 10.6218L20.2391 3H18.6854L12.9921 9.61788L8.44486 3H3.2002L10.0765 13.0074L3.2002 21H4.75404L10.7663 14.0113L15.5685 21H20.8131L13.6819 10.6218H13.6823ZM11.5541 13.0956L10.8574 12.0991L5.31391 4.16971H7.70053L12.1742 10.5689L12.8709 11.5655L18.6861 19.8835H16.2995L11.5541 13.096V13.0956Z',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/thadkrugman',
    icon: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
  },
];
---

<Container as='footer' className='pt-20 sm:pt-20 lg:pt-20 pb-8 sm:pb-8 lg:pb-8'>
  <div class='xl:grid xl:grid-cols-3 xl:gap-12'>
    <div class='space-y-8'>
      <a
        href='/'
        class='hover-lift-logo transition-all duration-300 flex items-end w-fit'
        aria-label='Home'
      >
        <SquareMousePointer
          stroke-width={2.2}
          class='size-11 text-foreground'
        />
      </a>
      <p class='text-pretty text-sm/6 text-foreground font-medium md:max-w-lg'>
        Crafting exceptional web experiences through innovative design and
        cutting-edge development. Let's bring your digital vision to life.
      </p>
      <div class='flex gap-x-6'>
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              class='text-foreground font-medium hover:text-accent'
            >
              <span class='sr-only'>{social.name}</span>
              <svg
                class='size-6'
                fill='currentColor'
                viewBox='0 0 24 24'
                aria-hidden='true'
              >
                <path fill-rule='evenodd' d={social.icon} clip-rule='evenodd' />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
    <div
      class='mt-16 grid grid-cols-2 gap-x-8 md:grid-cols-4 xl:col-span-2 xl:mt-0'
    >
      {
        footerSections.map((section, index) => (
          <div class={index >= 2 ? 'mt-10 md:mt-0' : ''}>
            <div class='text-base/6 font-bold text-foreground'>
              {section.title}
            </div>
            <ul role='list' class='mt-6 space-y-4'>
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='text-sm/6 text-foreground font-medium hover:text-foreground/75'
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <!-- Bottom Section -->
  <div class='pt-8 border-t border-muted mt-16'>
    <p class='text-sm/6 text-foreground font-medium text-left'>
      &copy; {new Date().getFullYear()} webexpressions. All rights reserved.
    </p>
  </div>
</Container>
