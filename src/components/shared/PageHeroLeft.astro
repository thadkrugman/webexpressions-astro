---
import Container from '@/components/shared/Container.astro';
import Button from '@/components/ui/Button.astro';
---

<Container as='header' className='pt-20 animate-fade-in-up scroll-trigger'>
  <p class='text-lg/7 lg:text-[21px]/7 font-bold text-accent-secondary'>
    Meet Your Developer
  </p>
  <h2
    class='[@media(max-width:439px)]:text-4xl text-5xl sm:text-6xl md:text-7xl lg:text-[84px] font-black tracking-tight text-foreground text-pretty mt-2 max-w-2xl'
  >
    Building digital experiences that matter
  </h2>
  <p class='mt-5 text-lg lg:text-xl/8 text-foreground font-medium max-w-2xl'>
    I'm a full-stack developer passionate about creating beautiful, functional
    websites that help businesses grow. With years of experience in modern web
    technologies, I focus on delivering solutions that are both user-friendly
    and performance-optimized.
  </p>
  <div class='flex flex-row gap-4 mt-9'>
    <Button size='xl'>Start Your Project</Button>
    <Button size='xl' variant='outline'>View Portfolio</Button>
  </div>
</Container>
