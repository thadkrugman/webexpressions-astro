---
import { cn } from '@/lib/utils';

interface Props {
  className?: string;
}

const { className = 'size-2.5' }: Props = Astro.props;
---

<div
  class={cn(`bg-accent rounded-full animate-pulse`, className)}
  aria-hidden='true'
>
  <div
    class={`bg-accent rounded-full animate-ping opacity-75 w-full h-full`}
    aria-hidden='true'
  >
  </div>
</div>
