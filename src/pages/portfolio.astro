---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import CallToAction from '@/components/shared/CallToAction.astro';
import ProjectContainer from '@/components/pages/portfolio/ProjectContainer.astro';

const seo = {
  title:
    'Web Design & Development Portfolio | Cleveland, Ohio | webexpressions',
  description:
    'Explore the portfolio of webexpressions, showcasing custom web applications, headless e-commerce platforms, and modern marketing sites built with React, Astro, and Svelte.',
  ogTitle: 'Where Form Meets Function | Selected Work by Thad Krugman',
  ogDescription:
    'A curated gallery of my work, where thoughtful design and robust engineering come together to create exceptional digital products for ambitious brands.',
  keywords:
    'web development portfolio, React developer, Astro developer, Svelte developer, headless e-commerce, custom web applications, marketing websites, Cleveland web developer, TypeScript development, TailwindCSS, modern web design, business-focused development, digital strategy, client partnership',
};
---

<Layout {...seo}>
  <PageHero
    kicker='Portfolio'
    heading='Where Form Meets Function'
    headingClassName='max-xs:max-w-[18rem] max-w-sm sm:max-w-md md:max-w-xl lg:max-w-3xl'
    description='Explore a curated gallery of my work, where thoughtful design and robust engineering come together to create exceptional digital products and experiences.'
    descriptionClassName='max-w-2xl'
    button='Start Your Own Project'
    buttonHref='/contact'
  />
  <ProjectContainer />
  <CallToAction
    kicker="Let's Work Together"
    heading='Tell Me About Your Project'
    button='Schedule a Call'
    buttonHref='/contact'
    button2='Browse The Blog'
    button2Href='/blog'
  />
</Layout>
