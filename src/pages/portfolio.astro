---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import CallToAction from '@/components/shared/CallToAction.astro';
import ProjectContainer from '@/components/pages/portfolio/ProjectContainer.astro';

// TODO: Update SEO
const seo = {
  title: 'About Web Expressions | My Philosophy & Process',
  description:
    'Learn about my philosophy on web development, commitment to client success, and how I can help you achieve your business goals through a strategic partnership.',
  ogTitle: 'The Philosophy Behind webexpressions | About Thad Krugman',
  ogDescription:
    'Discover the story behind webexpressions. I focus on building scalable, high-performance web solutions with a commitment to transparency and long-term support.',
  keywords:
    'about webexpressions, web development philosophy, Thad, web developer, business-focused development, client partnership, digital strategy',
};
---

<Layout {...seo}>
  <PageHero
    kicker='Portfolio'
    heading='Where Form Meets Function'
    headingClassName='max-xs:max-w-[18rem] max-w-sm sm:max-w-md md:max-w-xl lg:max-w-3xl'
    description='Explore a curated gallery of my work, where thoughtful design and robust engineering come together to create exceptional digital products and experiences.'
    descriptionClassName='max-w-2xl'
    button='Start Your Own Project'
    buttonHref='/contact'
  />
  <ProjectContainer />
  <CallToAction
    kicker="Let's Work Together"
    heading='Tell Me About Your Project'
    button='Schedule a Call'
    buttonHref='/contact'
    button2='Browse The Blog'
    button2Href='/blog'
  />
</Layout>
