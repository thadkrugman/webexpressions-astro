---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import CallToAction from '@/components/shared/CallToAction.astro';

// TODO: Update SEO
const seo = {
  title: 'About Web Expressions | My Philosophy & Process',
  description:
    'Learn about my philosophy on web development, commitment to client success, and how I can help you achieve your business goals through a strategic partnership.',
  ogTitle: 'The Philosophy Behind webexpressions | About Thad Krugman',
  ogDescription:
    'Discover the story behind webexpressions. I focus on building scalable, high-performance web solutions with a commitment to transparency and long-term support.',
  keywords:
    'about webexpressions, web development philosophy, Thad, web developer, business-focused development, client partnership, digital strategy',
};
---

<Layout {...seo}>
  <PageHero
    kicker='Blog'
    heading='Results-Driven Digital Experiences'
    headingClassName='max-w-3xl'
    description='I combine modern technology with a focus on business goals to build digital solutions that are beautiful, performant, and effective.'
    button='Book a Discovery Call'
    buttonHref='/contact'
  />
  <CallToAction
    kicker='Ready to Get Started?'
    heading="Let's Engineer Your Competitive Edge"
    button='Start Your Project'
    buttonHref='/contact'
    button2='My Portfolio'
    button2Href='/portfolio'
  />
</Layout>
