---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import BlogPosts from '@/components/pages/blog/BlogPosts.astro';

const seo = {
  title: 'Insights on the Modern Web | The webexpressions Blog',
  description:
    'Explore the webexpressions blog for articles and deep dives on modern web development, performance optimization, and SEO from developer Thad Krugman.',
  ogTitle: 'Insights on the Modern Web',
  ogDescription:
    'A collection of articles and deep dives on web development, performance optimization, and the technologies I use to build effective digital products.',
};
---

<Layout {...seo}>
  <PageHero
    kicker='Blog'
    heading='Insights on the Modern Web'
    headingClassName='max-xs:max-w-xs max-w-sm sm:max-w-lg lg:max-w-2xl'
    description='A collection of articles and deep dives on web development, performance optimization, and the technologies I use to build effective digital products.'
    descriptionClassName='max-w-3xl'
    button='Explore All Articles'
    buttonHref='#blog-posts'
  />
  <BlogPosts />
</Layout>
