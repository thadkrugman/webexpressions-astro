---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/shared/Container.astro';
import { Picture } from 'astro:assets';
import Thad from '@/assets/images/blog/thad.jpg';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = await getCollection('blog');

  return allPosts.map((post: CollectionEntry<'blog'>) => {
    return {
      params: { slug: post.data.slug },
      props: { post },
    };
  });
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

const seo = {
  title: `${post.data.title} | webexpressions Blog`,
  description: post.data.description,
  ogTitle: `${post.data.title} | Web Development Insights by Thad Krugman`,
  ogDescription: post.data.description,
  keywords: `${post.data.category.toLowerCase()}, web development, ${post.data.title.toLowerCase()}, programming, tech blog, webexpressions`,
};
---

<Layout {...seo}>
  <Container
    as='article'
    isFirstSection={true}
    includeBottomPadding={true}
    className='flex-1 min-w-0'
  >
    <!-- Article Header -->
    <header class='max-w-3xl animate-fade-in-up scroll-trigger mx-auto'>
      <p class='kicker'>{post.data.category}</p>

      <h1 class='heading-1 mt-2 text-pretty'>
        {post.data.title}
      </h1>

      <p
        class='mt-8 text-lg lg:text-xl/8 text-foreground font-medium text-pretty'
      >
        {post.data.description}
      </p>

      <!-- Author & Date Info -->
      <div class='mt-8 flex items-center gap-x-4'>
        <Picture
          src={Thad}
          alt='Thad Krugman'
          widths={[40, 80, 120]}
          sizes='40px'
          class='size-10 rounded-full'
          width={40}
          height={40}
        />
        <div class='text-sm/6 text-left'>
          <p class='font-extrabold text-foreground'>{post.data.author}</p>
          <p class='text-foreground font-medium'>
            <time
              datetime={new Date(post.data.pubDate).toISOString().split('T')[0]}
            >
              {
                new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC',
                })
              }
            </time>
          </p>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div
      class='prose prose-lg prose-gray mt-10 lg:mt-14 animate-fade-in-up scroll-trigger'
    >
      <Content />
    </div>
  </Container>
</Layout>

<style is:global>
  @import 'tailwindcss';

  .prose {
    @apply max-w-3xl mx-auto flex flex-col min-w-0 overflow-x-hidden text-[var(--color-foreground)] gap-y-0;
    width: 100%;
    flex-shrink: 2;
  }

  .prose h1 {
    @apply text-5xl font-extrabold tracking-tight text-[var(--color-foreground)] sm:text-6xl lg:text-7xl mt-16 lg:mt-20;
  }

  @media (max-width: 439px) {
    .prose h1 {
      @apply text-4xl;
    }
  }

  .prose h2 {
    @apply text-pretty text-3xl font-extrabold tracking-tight text-[var(--color-foreground)] sm:text-4xl lg:text-5xl mt-16 lg:mt-20;
  }

  @media (max-width: 439px) {
    .prose h2 {
      @apply text-2xl;
    }
  }

  .prose h3 {
    @apply text-pretty text-2xl font-extrabold text-[var(--color-foreground)] sm:text-3xl tracking-tight mt-14;
  }

  @media (max-width: 439px) {
    .prose h3 {
      @apply text-xl;
    }
  }

  .prose h4 {
    @apply text-pretty text-xl font-extrabold text-[var(--color-foreground)] sm:text-2xl tracking-tight mt-12;
  }

  @media (max-width: 439px) {
    .prose h4 {
      @apply text-lg;
    }
  }

  .prose p {
    @apply text-base/7 lg:text-lg/8 text-pretty font-medium mt-8;
  }

  .prose :is(h1, h2) + p {
    @apply mt-6;
  }

  .prose :is(h3, h4) + p {
    @apply mt-4;
  }

  .prose strong {
    font-weight: 800;
    color: var(--color-foreground);
  }

  .prose em {
    font-style: italic;
    color: var(--color-foreground);
  }

  .prose ul,
  .prose ol {
    font-size: 1rem;
    line-height: 1.75rem;
    color: var(--color-foreground);
    font-weight: 500;
  }

  .prose li {
    @apply relative mt-8 text-pretty font-medium text-base/7 lg:text-lg/8 list-none pl-4.5 lg:pl-5;
  }

  .prose li::before {
    content: '';
    @apply absolute top-0 left-0 size-2.5 lg:size-2.75 bg-[var(--color-accent)] rounded-full inline-flex mt-2.5 lg:mt-2.75;
  }

  .prose blockquote {
    border-left: 4px solid var(--color-accent);
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    background-color: oklch(from var(--color-muted) l c h / 0.5);
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-foreground);
    font-weight: 500;
    min-width: 0;
  }

  .prose code {
    @apply w-full;
    background-color: var(--color-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Monaco, Consolas, monospace;
    color: var(--color-accent-secondary);
    min-width: 0;
  }

  .prose h2 code {
    @apply text-xl sm:text-2xl lg:text-3xl;
  }

  .prose pre {
    @apply w-full p-6 mt-12 mb-4;
    background-color: var(--color-muted);
    border-radius: 0.75rem;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    font-family: ui-monospace, SFMono-Regular, Monaco, Consolas, monospace;
  }

  .prose pre code {
    @apply w-full;
    background-color: transparent;
    padding: 0;
    color: var(--color-foreground);
    white-space: pre;
    font-size: 0.875rem;
    overflow-x: auto;
  }

  .prose pre::-webkit-scrollbar {
    height: 10px;
  }

  .prose pre::-webkit-scrollbar-track {
    background: transparent;
  }

  .prose pre::-webkit-scrollbar-thumb {
    background-color: var(--color-accent);
    border-radius: 4px;
  }

  .prose a {
    color: var(--color-accent-secondary);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .prose a:hover {
    color: var(--color-accent);
  }

  .prose hr {
    border-top: 1px solid var(--color-muted);
    margin: 3rem 0;
  }
</style>
