---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/shared/Container.astro';
import { Picture } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = await getCollection('blog');

  return allPosts.map((post: CollectionEntry<'blog'>) => {
    return {
      params: { slug: post.data.slug },
      props: { post },
    };
  });
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

const seo = {
  title: `${post.data.title} | webexpressions Blog`,
  description: post.data.description,
  ogTitle: `${post.data.title} | Web Development Insights by Thad Krugman`,
  ogDescription: post.data.description,
  keywords: `${post.data.category.toLowerCase()}, web development, ${post.data.title.toLowerCase()}, programming, tech blog, webexpressions`,
};
---

<Layout {...seo}>
  <Container as='article' isFirstSection={true} includeBottomPadding={true}>
    <!-- Article Header -->
    <header class='max-w-3xl animate-fade-in-up scroll-trigger mx-auto'>
      <p class='kicker'>{post.data.category}</p>

      <h1 class='heading-1 mt-2 text-pretty'>
        {post.data.title}
      </h1>

      <p
        class='mt-8 text-lg lg:text-xl/8 text-foreground font-medium text-pretty'
      >
        {post.data.description}
      </p>

      <!-- Author & Date Info -->
      <div class='mt-8 flex items-center gap-x-4'>
        <Picture
          src='/src/assets/images/blog/thad.jpg'
          alt='Thad Krugman'
          widths={[40, 80, 120]}
          sizes='40px'
          class='size-10 rounded-full'
          width={40}
          height={40}
        />
        <div class='text-sm/6 text-left'>
          <p class='font-extrabold text-foreground'>{post.data.author}</p>
          <p class='text-foreground font-medium'>
            <time
              datetime={new Date(post.data.pubDate).toISOString().split('T')[0]}
            >
              {
                new Date(post.data.pubDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </time>
          </p>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div
      class='mt-16 lg:mt-20 max-w-3xl mx-auto animate-fade-in-up scroll-trigger'
    >
      <div class='prose prose-lg prose-gray max-w-none'>
        <Content />
      </div>
    </div>
  </Container>
</Layout>

<style is:global>
  /* Custom prose styles to match your design system */
  .prose {
    color: var(--color-foreground);
  }

  .prose h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h4 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-foreground);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    font-size: 1rem;
    line-height: 1.75rem;
    color: var(--color-foreground);
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .prose strong {
    font-weight: 700;
    color: var(--color-foreground);
  }

  .prose em {
    font-style: italic;
    color: var(--color-foreground);
  }

  .prose ul,
  .prose ol {
    font-size: 1rem;
    line-height: 1.75rem;
    color: var(--color-foreground);
    font-weight: 500;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.75rem;
  }

  .prose blockquote {
    border-left: 4px solid var(--color-accent);
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    background-color: oklch(from var(--color-muted) l c h / 0.5);
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-foreground);
    font-weight: 500;
  }

  .prose code {
    background-color: var(--color-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Monaco, Consolas, monospace;
    color: var(--color-accent-secondary);
  }

  .prose pre {
    background-color: var(--color-muted);
    padding: 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    margin: 2.5rem 0;
    max-width: 100%;
    white-space: pre;
    word-wrap: normal;
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
  }

  .prose pre::-webkit-scrollbar {
    height: 8px;
  }

  .prose pre::-webkit-scrollbar-track {
    background: transparent;
  }

  .prose pre::-webkit-scrollbar-thumb {
    background-color: var(--color-accent);
    border-radius: 4px;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: var(--color-foreground);
  }

  .prose a {
    color: var(--color-accent-secondary);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .prose a:hover {
    color: var(--color-accent);
  }

  .prose hr {
    border-top: 1px solid var(--color-muted);
    margin: 3rem 0;
  }

  /* Add spacing between sections */
  .prose > * + * {
    margin-top: 1.5rem;
  }

  .prose > h1 + *,
  .prose > h2 + *,
  .prose > h3 + *,
  .prose > h4 + * {
    margin-top: 1rem;
  }

  /* Responsive typography */
  @media (min-width: 768px) {
    .prose h1 {
      font-size: 2.5rem;
    }

    .prose h2 {
      font-size: 2rem;
    }

    .prose h3 {
      font-size: 1.75rem;
    }

    .prose p {
      font-size: 1.125rem;
      line-height: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .prose h1 {
      font-size: 3rem;
    }

    .prose h2 {
      font-size: 2.5rem;
    }

    .prose h3 {
      font-size: 2rem;
    }

    .prose p,
    .prose ul,
    .prose ol {
      font-size: 1.125rem;
      line-height: 1.875rem;
    }
  }
</style>
